# Copy to .env next to docker-compose.yml and fill in.
# Generate each secret with:
#   openssl rand -base64 48
JWT_SECRET=
# Encrypts stored mail passwords. Keep it stable: changing it makes
# existing accounts unreadable.
ENCRYPTION_KEY=

# Allowed client origins (comma-separated)
CORS_ORIGIN=http://localhost:3000,https://localhost,null

# Optional Google / Facebook sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# Public URLs used for OAuth callbacks, e.g. https://mail.example.com/api
API_URL=
CLIENT_URL=

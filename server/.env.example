# Server
PORT=3001
NODE_ENV=development
# Comma-separated list of allowed client origins
CORS_ORIGIN=http://localhost:3000

# Database
DATABASE_PATH=./webmail.db

# Security
JWT_SECRET=your-super-secret-jwt-key-change-in-production
# Encrypts stored mail passwords; changing it makes existing accounts unreadable
ENCRYPTION_KEY=your-32-character-encryption-key-here

# Public address of this server (e.g. https://mail.example.com). Google and
# Microsoft redirect back to PUBLIC_URL/api/auth/oauth/<provider>/callback
PUBLIC_URL=

# Google / Microsoft sign-in and mailboxes (optional). Each turns on only when
# both its client ID and secret are set; see README "Google and Microsoft"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# "common" accepts personal and work accounts; or your Azure tenant id
MICROSOFT_TENANT=common

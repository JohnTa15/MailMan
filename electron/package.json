{
  "name": "mailman-electron",
  "version": "1.0.0",
  "description": "Mailman - Cross-platform email client",
  "main": "main/main.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development concurrently \"npm run dev:server\" \"wait-on http://localhost:3000 && electron .\"",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=client",
    "package": "electron-builder",
    "postinstall": "install-app-deps"
  },
  "build": {
    "appId": "com.mailman.app",
    "productName": "Mailman",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "main/**/*",
      "../client/dist/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "deb",
          "arch": ["x64"]
        }
      ],
      "category": "Office",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "wait-on": "^7.2.0"
  }
}
